{
  "code": "jambread",
  "class": "scoopofjammod.ItemJamBreadAttributeVariants",
  "behaviors": [
    {
      "name": "AttributeRenderingLibrary.ShapeTexturesFromAttributes",
      "properties": {
        "textures": {
          "type-*::fruit-pineapple": {
            "bread": { "base": "game:item/food/grain/{type}bread" },
            "jam": { "base": "game:block/food/pie/fill-pineapple" }
          },
          "type-*::fruit-*apple": {
            "bread": { "base": "game:item/food/grain/{type}bread" },
            "jam": { "base": "game:block/food/pie/fill-apple" }
          },
          "type-*::fruit-*": {
            "bread": { "base": "game:item/food/grain/{type}bread" },
            "jam": { "base": "game:block/food/pie/fill-{fruit}" }
          }
        }
      }
    },
    {
      "name": "GroundStorable",
      "properties": {
        "layout": "Quadrants",
        "collisionBox": {
          "x1": 0,
          "y1": 0,
          "z1": 0,
          "x2": 1,
          "y2": 0.125,
          "z2": 1
        }
      }
    },
    {
      "name": "scoopofjammod.ExtraSatiety"
    },
    {
      "name": "scoopofjammod.AttributeVariants",
      "properties": {
        "attributeVariants": [
          {
            "code": "type",
            "states": [
              "spelt",
              "rye",
              "flax",
              "rice",
              "cassava",
              "amaranth",
              "sunflower"
            ]
          },
          {
            "loadFromProperties": "block/fruit"
          }
        ]
      }
    }
  ],
  "attributes": {
    "handbook": { "groupBy": ["jambread"] },
    "displaycaseable": true,
    "shelvable": true
  },
  "shape": { "base": "item/jambread" },
  // Just a default
  "textures": {
    "bread": { "base": "game:item/food/grain/speltbread" },
    "jam": { "base": "game:block/food/pie/fill-pineapple" }
  },
  // "creativeinventoryStacks" is created in code
  "nutritionPropsByType": {
    "*": { "saturation": 0, "foodcategory": "Grain" }
